
POSTGRES_DB=bloodell
POSTGRES_USER=bloodell
POSTGRES_PASSWORD=troque-esta-senha-localmente
POSTGRES_PORT=5432

BLOODELL_DB_URL=jdbc:postgresql://localhost:5432/bloodell
BLOODELL_DB_USER=bloodell
BLOODELL_DB_PASSWORD=troque-esta-senha-localmente
BLOODELL_PORT=8080
BLOODELL_LOG_LEVEL=DEBUG
BLOODELL_LOG_FILE=logs/bloodell.log
BLOODELL_CORS_ORIGENS=http://127.0.0.1:5173,http://localhost:5173

BLOODELL_TELEMETRIA_FILA=10000
BLOODELL_TELEMETRIA_WORKERS=4
BLOODELL_TELEMETRIA_LOTE=100

BLOODELL_DEMO_HABILITADO=true
BLOODELL_AUTH_HABILITADA=false

# Card 1: habilite somente com chave configurada e clientes preparados para Bearer.
# Base64 de pelo menos 32 bytes aleatorios; nunca versionar o valor real.
BLOODELL_JWT_SEGREDO_BASE64=
BLOODELL_JWT_EMISSOR=bloodell
BLOODELL_JWT_AUDIENCIA=bloodell-api
BLOODELL_JWT_VALIDADE=15m
# Provisionamento opcional em banco sem usuarios. Remova a senha apos o primeiro uso.
BLOODELL_ADMIN_INICIAL_HABILITADO=false
BLOODELL_ADMIN_NOME=
BLOODELL_ADMIN_EMAIL=
BLOODELL_ADMIN_SENHA=
